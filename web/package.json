{
  "name": "hevm-web",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "mkdir -p public && cp ../dist-wasm/hevm.wasm ../dist-wasm/hevm-web.wasm ../dist-wasm/hevm-web.js node_modules/solc/soljson.js public/",
    "predev": "npm run assets",
    "dev": "vite",
    "prebuild": "npm run assets",
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p debugger --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "playwright-core": "^1.65.1",
    "solc": "0.8.39",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "^0.4.2",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@replit/codemirror-lang-solidity": "^6.0.2",
    "codemirror": "^6.0.2"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
